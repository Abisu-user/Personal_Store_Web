NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: set only in Vercel and .env.local. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
# Optional: enables Vocabulary's AI explanation, comparison, translation and autofill.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_VOCABULARY_MODEL=gpt-4.1-mini

# Phase 3 Backblaze B2 connection (server-only; never use NEXT_PUBLIC_ for these values).
B2_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=personal-vault-storage
