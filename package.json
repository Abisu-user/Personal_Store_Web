{
  "name": "vault-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vocabulary:import": "node scripts/vocabulary/import-system-datasets.mjs",
    "vocabulary:import:ja": "node scripts/vocabulary/import-system-datasets.mjs --language=ja",
    "vocabulary:import:en": "node scripts/vocabulary/import-system-datasets.mjs --language=en",
    "vocabulary:build:ja-zh-tw": "node scripts/vocabulary/build-openjlpt-tomoshi-zhtw.mjs",
    "vocabulary:hydrate:ja-zh-tw": "node scripts/vocabulary/hydrate-japanese-traditional-chinese.mjs",
    "vocabulary:examples:import": "node scripts/vocabulary/run-system-examples-import.mjs",
    "vocabulary:examples:report": "node scripts/vocabulary/run-system-examples-import.mjs --dry-run",
    "test:vocabulary:translations": "node --test scripts/vocabulary/tomoshi-zhtw.test.mjs",
    "test:vocabulary:examples": "node --test scripts/vocabulary/system-examples-regression.test.mjs",
    "test:auth:otp": "node --experimental-strip-types --test scripts/auth/otp-policy.test.mjs",
    "test:appearance:backgrounds": "node --experimental-strip-types --test scripts/appearance/background-image-format.test.mjs",
    "test:account-isolation": "node --experimental-strip-types --test scripts/system/account-isolation-quota.test.mjs",
    "test:storage": "node --conditions=react-server --experimental-strip-types --test scripts/storage/*.test.mjs",
    "test:storage:live": "node --experimental-strip-types scripts/storage/live-validation.mjs",
    "test:storage:r2": "node --conditions=react-server --experimental-strip-types --test scripts/storage/r2-provider.test.mjs",
    "test:storage:r2:live": "node --conditions=react-server --experimental-strip-types scripts/storage/r2-live-validation.mjs",
    "test:storage:b2": "node --conditions=react-server --experimental-strip-types --test scripts/storage/b2-provider.test.mjs",
    "test:storage:b2:live": "node --conditions=react-server --experimental-strip-types scripts/storage/b2-live-validation.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "opencc-js": "^1.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sql.js": "^1.14.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5"
  }
}
